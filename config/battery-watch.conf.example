# Settings for ALL notifications of this rig, not just battery ones: sleep-toggle,
# backpack-mode and backpack-health read the topic from here too. The filename is
# historical. Delete this file and they all go silent.
# Keep it private: the topic name is the entire secret.

# Backend: ntfy | telegram
BACKEND=ntfy

# --- ntfy.sh ---
# Whoever knows NTFY_TOPIC can read it and post to it. Do not publish it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=<generate one: batt-$(tr -dc a-z0-9 </dev/urandom | head -c 24)>

# --- telegram (used when BACKEND=telegram) ---
TG_TOKEN=
TG_CHAT_ID=

# Discharge thresholds in percent, descending
THRESHOLDS="90 80 70 60 50 40 30 20 10 5"

# How often to check is set in the launchd plist (StartInterval); noted here for reference
