# Backpack mode: what to freeze while the lid is closed and sleep is disabled.
#
# Freezing means SIGSTOP: the process stops dead (zero CPU), its memory stays,
# and SIGCONT resumes it exactly where it was. Nothing is killed or lost.

# Applications to freeze, one per line. Matched against processes of the
# current user by the path /Applications/<name>.app/
# This is a BLACKLIST, not a whitelist: name what to silence, not what to keep.
# A whitelist would freeze your VPN sooner or later, and behind a closed lid
# that cannot be undone.
FREEZE_APPS="Telegram
Google Chrome
Slack
Spotify"

# Hard exclusions: never touched, even if matched by the list above.
# Matched as a substring of the process's full path.
#
# PUT YOUR VPN CLIENT HERE, ALONG WITH ANYTHING YOU REACH THIS MACHINE THROUGH.
# A frozen VPN behind a closed lid cannot be fixed: you have lost the
# connection and there is nobody there to wake the machine. Names are often
# not what you expect and live outside /Applications (system extensions,
# binaries in /usr/local/bin), so check what the process is actually called:
#
#     ps -Ao args | grep -i <name>
#
# Below is only what the rig needs in order not to break itself.
NEVER_FREEZE="Terminal
iTerm
Visual Studio Code
claude
node
ssh
SystemExtensions
/System/
/usr/libexec/"

# Log the list of frozen processes
VERBOSE_LOG=1

# Extra: freeze by substring of the process's full path. Needed for things
# living outside /Applications - Steam, for example, keeps itself and its
# games under ~/Library/Application Support/Steam/, while /Applications holds
# only the launcher.
FREEZE_PATHS="Library/Application Support/Steam
steamapps/common"
