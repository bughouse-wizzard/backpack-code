# Режим рюкзака: что замораживать, когда крышка закрыта и сон запрещён.
#
# Замораживание - это SIGSTOP: процесс останавливается намертво (ноль CPU),
# память остаётся, при SIGCONT продолжает с того же места. Ничего не теряется.

# Приложения на заморозку. По одному в строке, ищутся по пути
# /Applications/<имя>.app/ среди процессов текущего пользователя.
# Здесь ЧЁРНЫЙ список, а не белый: перечисляем что глушить, а не что оставить.
# Белый список однажды заморозил бы VPN, и с закрытой крышкой это не чинится.
FREEZE_APPS="Telegram
Google Chrome
Slack
Spotify"

# Жёсткий запрет: даже если попадёт в список выше, трогать нельзя.
# Совпадение по подстроке в полном пути процесса.
#
# ВПИШИ СЮДА СВОЙ VPN-КЛИЕНТ И ВСЁ, ЧЕРЕЗ ЧТО ХОДИШЬ НА МАШИНУ.
# Замороженный VPN за закрытой крышкой не чинится: связи с ноутом больше нет,
# а разбудить его некому. Имена бывают неочевидными и лежат вне /Applications
# (системные расширения, бинари в /usr/local/bin), поэтому проверяй, как
# процесс реально зовётся:
#
#     ps -Ao args | grep -i <имя>
#
# Дальше - только то, без чего оснастка сломает сама себя.
NEVER_FREEZE="Terminal
iTerm
Visual Studio Code
claude
node
ssh
SystemExtensions
/System/
/usr/libexec/"

# Писать в лог список замороженных процессов
VERBOSE_LOG=1

# Дополнительно: заморозка по подстроке в полном пути процесса.
# Нужно для того, что живёт вне /Applications - например, Steam держит и себя,
# и игры в ~/Library/Application Support/Steam/, а в /Applications только оболочка.
FREEZE_PATHS="Library/Application Support/Steam
steamapps/common"
